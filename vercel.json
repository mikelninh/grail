{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {"source": "/", "destination": "/dashboard/index.html"}
  ],
  "functions": {
    "api/opportunities.py": {"maxDuration": 30},
    "api/owner.py": {"maxDuration": 15}
  },
  "headers": [
    {"source": "/dashboard/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=300"}]}
  ]
}
